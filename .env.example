# ─────────────────────────────────────────────────────────────────────────────
# stuf-web — server environment variables
#
# Configure these in Vercel:  Project → Settings → Environment Variables
# (Production + Preview).  These are SERVER-ONLY secrets read by
# lib/server/supabase-admin.ts — do NOT prefix with NEXT_PUBLIC (that would
# expose the service-role key to the browser).  Never commit real values;
# .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# (NEXT_PUBLIC_SUPABASE_URL is accepted as a fallback.)
SUPABASE_URL=

# Supabase SERVICE ROLE key — full read/write access. Keep secret, server-only.
# (SUPABASE_KEY is accepted as a fallback.)
SUPABASE_SERVICE_ROLE_KEY=
